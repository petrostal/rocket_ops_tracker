APP_ENV=production
# Required: generate unique values before running Compose.
APP_SECRET=
PUBLIC_URL=https://tasks.example.com
ATTACHMENTS_DIR=/data/attachments
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_MAX_PER_TASK=50
ATTACHMENT_TOTAL_MAX_BYTES_PER_TASK=262144000
ATTACHMENT_TOTAL_MAX_BYTES_PER_USER=1073741824
COMMENT_MAX_PER_TASK=1000
ROCKETCHAT_URL=https://chat.example.com

ROCKETCHAT_CLIENT_ID=
ROCKETCHAT_CLIENT_SECRET=
ROCKETCHAT_BOT_USER_ID=
ROCKETCHAT_BOT_TOKEN=
ROCKETCHAT_APP_SECRET=

POSTGRES_DB=opstracker
POSTGRES_USER=opstracker
POSTGRES_PASSWORD=

ALLOWED_ORIGINS=https://chat.example.com,https://tasks.example.com
ALLOWED_FRAME_ORIGIN=https://chat.example.com
TASK_ADMIN_USERNAMES=
SESSION_TTL_MINUTES=480
INTEGRATION_MAX_AGE_SECONDS=300
LAUNCH_CODE_TTL_SECONDS=60

NOTIFY_TASK_CREATED=true
NOTIFY_TASK_ASSIGNED=true
NOTIFY_TASK_STARTED=false
NOTIFY_TASK_COMPLETED=true
NOTIFY_TASK_OVERDUE=true
NOTIFY_CREATOR_UPDATES=true
OVERDUE_CHECK_INTERVAL_SECONDS=300

TASKS_DOMAIN=tasks.example.com
TASKS_BIND_ADDRESS=127.0.0.1
TASKS_HTTP_PORT=8088
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
CSP_EXTERNAL_IMAGE_SOURCES=https://i.gyazo.com
WEB_CONCURRENCY=1
